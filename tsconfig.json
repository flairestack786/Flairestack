{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [{ "name": "next" }],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "src/app/**/*.ts",
    "src/app/**/*.tsx",
    "src/lib/next/**/*.ts",
    "src/lib/next/**/*.tsx",
    "src/lib/optionalMedia.js",
    "src/config/contact.js",
    "src/data/companyStats.js",
    "src/data/homeProcessSteps.js",
    "src/data/founders.js",
    "src/data/homeTestimonials.js",
    "src/data/serviceTestimonials.js",
    "src/data/technologies.js",
    "src/data/inquiryServices.js",
    "src/data/techIcons.json",
    "src/components/about/**/*.{js,jsx}",
    "src/about-page.css",
    "src/lib/lucideIcons.js",
    "src/lib/buildPublicServicePageCore.js",
    "src/components/TrustedBy.jsx",
    "src/components/CompanyStatsView.jsx",
    "src/components/inquiry/ServiceSelect.jsx",
    "src/components/service/ServiceMotion.jsx",
    "src/components/service/ServicePageLayout.jsx",
    "src/components/service/ServiceHeroCarousel.jsx",
    "src/components/service/ServiceTestimonialsSlider.jsx",
    "src/components/service/FrameworkSection.jsx",
    "src/components/service/IndustriesSection.jsx",
    "src/components/service/framework-section.css",
    "src/components/service/industries-section.css",
    "src/components/next/public/**/*.{ts,tsx}",
    "src/components/ScrollToTopButton.jsx",
    "src/lib/cmsPermissions.js",
    "src/lib/leadsFormat.js",
    "src/lib/usersFormat.js",
    "src/lib/mediaFormat.js",
    "src/lib/mediaMetadata.js",
    "src/lib/serviceMediaSlots.js",
    "src/lib/serviceSlug.js",
    "src/lib/serviceUrlFlow.js",
    "src/lib/serviceDefaults.js",
    "src/lib/serviceCatalogAssets.js",
    "src/lib/seoAnalysis.js",
    "src/lib/seoPayload.js",
    "src/lib/seoCounters.js",
    "src/lib/seoCore.js",
    "src/lib/seoInheritance.js",
    "src/data/adminNav.js",
    "src/data/services.js",
    "src/data/serviceVisuals.js",
    "src/data/servicePageContent.js",
    "src/data/companyStats.js",
    "src/components/admin/dashboard/**/*.{js,jsx}",
    "src/components/admin/leads/LeadDetailDrawer.jsx",
    "src/components/admin/users/**/*.{js,jsx}",
    "src/components/admin/home/**/*.{js,jsx}",
    "src/components/admin/services/**/*.{js,jsx}",
    "src/components/admin/about/**/*.{js,jsx}",
    "src/components/admin/seo/**/*.{js,jsx}",
    "src/components/admin/settings/**/*.{js,jsx}",
    "src/components/admin/MediaUrlContext.jsx",
    "src/components/admin/MediaGrid.jsx",
    "src/components/admin/MediaGridCard.jsx",
    "src/components/admin/MediaUploader.jsx",
    "src/components/admin/MediaCopyUrlButton.jsx",
    "src/components/admin/ImagePickerModal.jsx",
    "src/components/admin/RenameImageModal.jsx",
    "src/components/admin/AdminSelect.jsx",
    "src/components/admin/ConfirmationModal.jsx",
    "src/components/common/ToastProvider.jsx",
    "src/components/common/Toast.jsx",
    "src/admin-dashboard.css",
    "src/admin-auth.css",
    "server/**/*.mjs",
    ".next/types/**/*.ts"
  ],
  "exclude": ["node_modules", "dist", "server", "api", "scripts"]
}
