# EmailJS — https://dashboard.emailjs.com/admin
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=
VITE_EMAILJS_TO_EMAIL=info@flairestack.com

# Cloudflare Turnstile (public site key — safe for browser)
VITE_TURNSTILE_SITE_KEY=

# Optional: API base URL in production (e.g. https://api.yourdomain.com)
# Leave empty in dev — Vite proxies /api to the Express server on port 3001
VITE_API_BASE_URL=

# ---------------------------------------------------------------------------
# Vite browser Supabase (current SPA — npm run dev)
# ---------------------------------------------------------------------------
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# Next.js browser Supabase (npm run dev:next) — Phase 2+
# Required for Next /admin/login. Same project values as VITE_* above.
# NEVER put SUPABASE_SERVICE_ROLE_KEY or TURNSTILE_SECRET_KEY in NEXT_PUBLIC_*.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# NEXT_PUBLIC_EMAILJS_SERVICE_ID=
# NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
# NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=
# NEXT_PUBLIC_EMAILJS_TO_EMAIL=info@flairestack.com
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Server-only — used by Express / Next Route Handlers (never expose to the browser)
TURNSTILE_SECRET_KEY=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Canonical origin for server-generated invite / admin password-reset email links.
# Required for correct redirects while Vite + Next run side by side.
# - Vite CMS (npm run dev):        SITE_URL=http://localhost:5173
# - Next CMS (npm run dev:next):   SITE_URL=http://localhost:3000
# - Production (Vercel):           SITE_URL=https://<your-live-domain>
# Optional alias when SITE_URL is unset: NEXT_PUBLIC_SITE_URL (same value; still not a secret).
# On Vercel, if both are unset, getSiteUrl() may fall back to VERCEL_PROJECT_PRODUCTION_URL.
SITE_URL=http://localhost:5173
# NEXT_PUBLIC_SITE_URL=http://localhost:3000
#
# ---------------------------------------------------------------------------
# Production cutover checklist (Vercel project env — set manually; do not invent)
# ---------------------------------------------------------------------------
# Required for Next public + admin:
#   NEXT_PUBLIC_SUPABASE_URL          (or rely on next.config VITE_SUPABASE_URL fallback)
#   NEXT_PUBLIC_SUPABASE_ANON_KEY     (or rely on next.config VITE_SUPABASE_ANON_KEY fallback)
#   SUPABASE_URL
#   SUPABASE_ANON_KEY
#   SUPABASE_SERVICE_ROLE_KEY
#   TURNSTILE_SECRET_KEY
#   SITE_URL=https://<your-live-domain>
# Strongly recommended:
#   NEXT_PUBLIC_SITE_URL=https://<your-live-domain>
#   NEXT_PUBLIC_TURNSTILE_SITE_KEY    (or VITE_TURNSTILE_SITE_KEY via next.config)
#   NEXT_PUBLIC_EMAILJS_*             (or VITE_EMAILJS_* via next.config)
# CMS (admin SEO → Global): set canonical_base_url to https://<your-live-domain>
# Analytics IDs live in site_settings (CMS), not env.
