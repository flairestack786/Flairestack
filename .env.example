# FlaireStack — Next.js App Router only
# Copy to .env.local for local development. Never commit secrets.

# ---------------------------------------------------------------------------
# Browser-safe public env (NEXT_PUBLIC_*)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# EmailJS — https://dashboard.emailjs.com/admin
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=
NEXT_PUBLIC_EMAILJS_TO_EMAIL=info@flairestack.com
# Server-side job application confirmation (separate EmailJS service — do not reuse inquiry service)
# EMAILJS_APPLICATION_SERVICE_ID=service_qbexphi
# EMAILJS_APPLICATION_TEMPLATE_ID=
# EMAILJS_PUBLIC_KEY=
# EMAILJS_PRIVATE_KEY=
# Template To Email: {{to_email}}
# Template variables: to_email, first_name, job_title, subject, message_html

# Cloudflare Turnstile (public site key — safe for browser)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Optional public site origin (used when SITE_URL is unset)
# NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase Storage Image Transformations for public CMS images (WebP/resized).
# Default: enabled. Requires Pro+ with Image Transformations turned on in Storage.
# Set to 0/false on Free plan (or if transforms 404) to serve original object URLs.
# NEXT_PUBLIC_SUPABASE_IMAGE_TRANSFORMS=1

# ---------------------------------------------------------------------------
# Server-only — Next Route Handlers (never expose as NEXT_PUBLIC_*)
# ---------------------------------------------------------------------------
TURNSTILE_SECRET_KEY=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Canonical origin for invite / admin password-reset email links.
# Local:  SITE_URL=http://localhost:3000
# Prod:   SITE_URL=https://<your-live-domain>
SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Production cutover checklist (Vercel project env — set manually)
# ---------------------------------------------------------------------------
# Required:
#   NEXT_PUBLIC_SUPABASE_URL
#   NEXT_PUBLIC_SUPABASE_ANON_KEY
#   SUPABASE_URL
#   SUPABASE_ANON_KEY
#   SUPABASE_SERVICE_ROLE_KEY
#   TURNSTILE_SECRET_KEY
#   SITE_URL=https://<your-live-domain>
# Strongly recommended:
#   NEXT_PUBLIC_SITE_URL=https://<your-live-domain>
#   NEXT_PUBLIC_TURNSTILE_SITE_KEY
#   NEXT_PUBLIC_EMAILJS_*
# CMS (admin SEO → Global): set canonical_base_url to https://<your-live-domain>
# Analytics IDs live in site_settings (CMS), not env.
