# EmailJS — https://dashboard.emailjs.com/admin
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=
VITE_EMAILJS_TO_EMAIL=info@flairestack.com

# Cloudflare Turnstile (public site key — safe for browser)
VITE_TURNSTILE_SITE_KEY=

# Optional: API base URL in production (e.g. https://api.yourdomain.com)
# Leave empty in dev — Vite proxies /api to the Express server on port 3001
VITE_API_BASE_URL=

# ---------------------------------------------------------------------------
# Vite browser Supabase (current SPA — npm run dev)
# ---------------------------------------------------------------------------
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# Next.js browser Supabase (npm run dev:next) — Phase 2+
# Required for Next /admin/login. Same project values as VITE_* above.
# NEVER put SUPABASE_SERVICE_ROLE_KEY or TURNSTILE_SECRET_KEY in NEXT_PUBLIC_*.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# NEXT_PUBLIC_EMAILJS_SERVICE_ID=
# NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
# NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=
# NEXT_PUBLIC_EMAILJS_TO_EMAIL=info@flairestack.com
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Server-only — used by Express / future Next Route Handlers (never expose to the browser)
TURNSTILE_SECRET_KEY=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SITE_URL=http://localhost:5173
# When using Next locally for auth redirects later, also allow:
# SITE_URL=http://localhost:3000
